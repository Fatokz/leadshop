# Copy to .env.local and fill in. Without the Firebase values the app runs in demo mode
# (in-memory data, simulated sign-in) — fine for local testing, not for deployment.

# --- Firebase web app (Firebase console → Project settings → Your apps → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (Project settings → Service accounts → Generate new private key)
# Keep the private key on one line with literal \n sequences, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Comma-separated emails allowed into /admin (LCU Student Affairs / Security).
ADMIN_EMAILS=


# Fill an empty Firestore with the LCU demo stores on first load (local/demo only).
AUTO_SEED_DEMO=false

# Interswitch: ONE switch. TEST = sandbox + Interswitch's dummy test cards.
# LIVE = hackathon merchant MX153376, real cards only (from ₦10). Team 20 shares
# "Hackathon Team 10" (pay item 9381029); declare this when asked.
# Restart `npm run dev` after changing it.
NEXT_PUBLIC_ISW_MODE=TEST

# Optional: your OWN Quickteller Business test merchant (Dashboard → Developer Tools →
# Integration Credentials). The shared test merchant MX6072 only offers "Pay on Credit",
# so test cards need your own. Leave blank to use the defaults for the mode above.
NEXT_PUBLIC_ISW_MERCHANT_CODE=
NEXT_PUBLIC_ISW_PAY_ITEM_ID=
