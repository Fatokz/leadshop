rules_version = '2';
// Signed-in users can upload images (max 5 MB) into their own folder.
// Files are viewed through their tokenised download URLs only.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{folder}/{file} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (folder == 'docs' || folder == 'products')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if false;
    }
  }
}
